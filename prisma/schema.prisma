generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DOKTER
  FARMASI
  LAB
  RADIOLOGI
  RAWAT_INAP
  LOGISTIK
  PERAWAT
  RESEPSIONIS
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum JenisIdentitas {
  KTP
  PASPOR
  BUKU_NIKAH
  AKTA_KELAHIRAN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  nama              String
  role              Role      @default(RESEPSIONIS)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLogin         DateTime?

  dokter            Dokter?
  auditTrail        AuditTrail[]

  @@index([email])
  @@index([role])
}

model AuditTrail {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  modul     String
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model Pasien {
  id                    String   @id @default(cuid())
  nomorRekamMedis       String   @unique
  nama                  String
  nik                   String   @unique
  jenisIdentitas        JenisIdentitas
  noIdentitas           String   @unique
  tempatLahir           String
  tanggalLahir          DateTime
  gender                Gender
  agama                 String?
  pekerjaan             String?
  noHP                  String?
  email                 String?
  alamat                String
  kelurahan             String?
  kecamatan             String?
  kabupaten             String?
  provinsi              String?
  kodePOS               String?
  namaOrangTua          String?
  hubunganDarurat       String?
  noHubunganDarurat     String?
  asuransi              String?
  noAsuransi            String?
  statusAsuransi        String?
  catatanMedis          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  kunjungan             Kunjungan[]
  resep                 Resep[]
  permintaanLab         PermintaanLab[]
  hasilLab              HasilLab[]
  rawatInap             RawatInap[]
  visiasi               Visiasi[]

  @@index([nomorRekamMedis])
  @@index([nik])
  @@index([nama])
}

model Kunjungan {
  id               String   @id @default(cuid())
  pasienId         String
  pasien           Pasien   @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  dokterDinas      String?
  keluhan          String
  tipeKunjungan    String
  diagnosis        String?
  terapi           String?
  tanggalKunjungan DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([pasienId])
  @@index([tanggalKunjungan])
}

model Dokter {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip           String   @unique
  spesialisasi  String
  noSTR         String?
  noSIP         String?
  noHP          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jadwal        JadwalDokter[]

  @@index([nip])
}

model JadwalDokter {
  id         String   @id @default(cuid())
  dokterID   String
  dokter     Dokter   @relation(fields: [dokterID], references: [id], onDelete: Cascade)
  hari       String
  jamMulai   String
  jamSelesai String
  poliklinik String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dokterID])
}

model Obat {
  id                String   @id @default(cuid())
  kodeObat          String   @unique
  nama              String
  jenis             String
  satuan            String
  harga             Float
  stokSekarang      Int
  stokMinimal       Int      @default(10)
  namaPabrik        String?
  nomorBatch        String?
  tanggalKadaluarsa DateTime?
  deskripsi         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resepObat         ResepObat[]
  logStok           LogStokObat[]

  @@index([kodeObat])
  @@index([nama])
  @@index([stokSekarang])
}

model LogStokObat {
  id        String   @id @default(cuid())
  obatId    String
  obat      Obat     @relation(fields: [obatId], references: [id], onDelete: Cascade)
  tipe      String
  jumlah    Int
  keterangan String?
  tanggal   DateTime @default(now())

  @@index([obatId])
}

model Resep {
  id           String   @id @default(cuid())
  nomorResep   String   @unique
  pasienId     String
  pasien       Pasien   @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  dokterDinas  String
  tanggalResep DateTime @default(now())
  catatanResep String?
  statusResep  String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  obat         ResepObat[]

  @@index([pasienId])
  @@index([nomorResep])
}

model ResepObat {
  id        String @id @default(cuid())
  resepId   String
  resep     Resep  @relation(fields: [resepId], references: [id], onDelete: Cascade)
  obatId    String
  obat      Obat   @relation(fields: [obatId], references: [id], onDelete: Cascade)
  jumlah    Int
  aturan    String

  @@index([resepId])
  @@index([obatId])
}

model PermintaanLab {
  id                String   @id @default(cuid())
  nomorPermintaan   String   @unique
  pasienId          String
  pasien            Pasien   @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  dokterDinas       String
  jenisPermintaan   String
  tipePermeriksaan  String
  indikasi          String?
  prioritas         String   @default("NORMAL")
  statusPermintaan  String   @default("PENDING")
  tanggalPermintaan DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hasilLab          HasilLab[]

  @@index([pasienId])
  @@index([nomorPermintaan])
}

model HasilLab {
  id             String   @id @default(cuid())
  nomorHasil     String   @unique
  permintaanId   String
  permintaan     PermintaanLab @relation(fields: [permintaanId], references: [id], onDelete: Cascade)
  pasienId       String
  pasien         Pasien   @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  petugasInput   String
  hasil          String
  nilaiReferensi String?
  kesimpulan     String?
  tanggalHasil   DateTime @default(now())
  statusHasil    String   @default("PROSES")
  fileHasil      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([pasienId])
  @@index([permintaanId])
}

model Kamar {
  id             String   @id @default(cuid())
  nomorKamar     String   @unique
  tipeKamar      String
  kapasitas      Int      @default(1)
  terisiSekarang Int      @default(0)
  hargaPerHari   Float
  status         String   @default("KOSONG")
  fasilitas      String?
  catatan        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rawatInap      RawatInap[]

  @@index([nomorKamar])
  @@index([status])
}

model RawatInap {
  id             String   @id @default(cuid())
  pasienId       String
  pasien         Pasien   @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  kamarId        String
  kamar          Kamar    @relation(fields: [kamarId], references: [id], onDelete: Restrict)
  tanggalMasuk   DateTime @default(now())
  tanggalKeluar  DateTime?
  diagnosaAwal   String
  statusRawatInap String  @default("MASUK")
  catatan        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  visite         Visiasi[]

  @@index([pasienId])
  @@index([kamarId])
}

model Visiasi {
  id            String   @id @default(cuid())
  rawatInapId   String
  rawatInap     RawatInap @relation(fields: [rawatInapId], references: [id], onDelete: Cascade)
  pasienId      String
  pasien        Pasien     @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  dokterDinas   String
  tanggalVisite DateTime @default(now())
  subjektif     String?
  objektif      String?
  asesment      String?
  planning      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([rawatInapId])
  @@index([pasienId])
}

model Barang {
  id              String   @id @default(cuid())
  kodeBarang      String   @unique
  nama            String
  kategori        String
  satuan          String
  harga           Float
  stokSekarang    Int
  stokMinimal     Int      @default(5)
  lokasi          String?
  supplier        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logStok         LogStokBarang[]
  permintaanBarang PermintaanBarang[]

  @@index([kodeBarang])
  @@index([nama])
}

model LogStokBarang {
  id        String   @id @default(cuid())
  barangId  String
  barang    Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  tipe      String
  jumlah    Int
  keterangan String?
  tanggal   DateTime @default(now())

  @@index([barangId])
}

model PermintaanBarang {
  id                String   @id @default(cuid())
  nomorPermintaan   String   @unique
  barangId          String
  barang            Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  unitPeminta       String
  jumlah            Int
  keperluan         String?
  prioritas         String   @default("NORMAL")
  statusPermintaan  String   @default("PENDING")
  tanggalPermintaan DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([barangId])
  @@index([nomorPermintaan])
}

model Statistik {
  id          String   @id @default(cuid())
  tipe        String
  bulan       Int
  tahun       Int
  jumlah      Int
  data        String?
  lastUpdated DateTime @default(now())

  @@unique([tipe, bulan, tahun])
}
